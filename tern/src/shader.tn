let extract_position = fn(input: vs_output) -> float3 {
    return .{input.position[0], input.position[1], input.position[2]}
}

let random = fn() -> u32 ---

let uniter: fn () = fn() ---

let fib = fn(n: i32) -> i32 {
    if (n <= 1i32) return n
    return fib(n - 1i32) + fib(n - 2i32)
}

@PIXEL
export fn ps_main(input: vs_output, in_string: string) -> ps_output {
    let result = input
        |> extract_position(_)
    let first_char = if (in_string.len > 0) in_string[0] else 0u8

    let rr = match (fruit.apple) {
        .apple => 1,
        .banana => 2,
        .cherry => 3,
    }

    mut x = fruit.apple.nomnomnom()
    fruit.apple.thiswontmethodise()

    let some_ptr: *vs_output = &input

    return .{
        color = float4{input.color[0], input.color[1], input.color[2], 1.0},
    }
}

