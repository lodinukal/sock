let float3 = [3]f32
let float4 = [4]f32
let leto = f32
let m: leto = 1.0

let vs_input = struct {
    position: float3,
    color: float3,
}

let vs_output = struct {
    position: float4,
    color: float3,
}

let ps_output = struct {
    color: float4,
}

let rhs_fn = fn(a: f32, b: f32) -> f32 {
    return a + b
}

// @VERTEX
// export fn vs_main(input: vs_input) -> vs_output {
//     return .{
//         position = float4(input.position[0], input.position[1], input.position[2], 1.0),
//         color = input.color,
//     }
// }

let extract_position = fn(input: vs_output) -> float3 {
    return .{input.position[0], input.position[1], input.position[2]}
}

@PIXEL
export fn ps_main(input: vs_output, in_string: string) -> ps_output {
    let result = input
        |> extract_position(_)
    let first_char = in_string[0]
    mut copy_input = input
    copy_input.position[0] = result[0]
    return .{
        color = float4{input.color[0], input.color[1], input.color[2], 1.0},
    }
}